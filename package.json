{
  "name": "invoices-api",
  "version": "1.0.0",
  "description": "Una API diseñada para gestionar facturas",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:ui": "vitest --ui",
